{
  // 面板源码跑在浏览器里，单独一份带 DOM 的配置；Node 侧那份不放 DOM。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/webui/**/*.ts", "src/webui/**/*.d.ts"]
}
